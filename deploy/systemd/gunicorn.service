[Unit]
Description=Gestia gunicorn
After=network.target postgresql.service

[Service]
User=gestia
Group=www-data
WorkingDirectory=/var/www/gestia
EnvironmentFile=/var/www/gestia/.env
ExecStart=/var/www/gestia/.venv/bin/gunicorn config.wsgi:application --bind unix:/run/gestia/gunicorn.sock --workers 2 --timeout 120
Restart=always

[Install]
WantedBy=multi-user.target
